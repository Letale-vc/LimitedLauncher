<Window x:Class="LimitedLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LimitedLauncher" Width="620" Height="580" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        ThemeMode="System"
        Drop="Window_Drop" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="70" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="LimitedLauncher" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,2" />
        <TextBlock Grid.Row="1" Margin="0,0,0,14" Text="Run any program under a separate limited Windows account."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Limited user" Style="{StaticResource Title}" Grid.ColumnSpan="2" />

                <TextBlock Text="User" Style="{StaticResource Caption}" Grid.Row="1" />
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="UserBox" IsEditable="True" SelectionChanged="UserBox_Changed" LostFocus="UserBox_Changed" />
                    <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0" />
                </Grid>

                <TextBlock Text="Password" Style="{StaticResource Caption}" Grid.Row="2" Margin="0,10,12,0" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" />

                <TextBlock x:Name="PasswordHint" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           Text="Leave the password empty to generate one (saved encrypted for your Windows account)." />

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Create user" Click="Create_Click" Style="{DynamicResource AccentButtonStyle}" />
                    <Button Content="Remove user" Click="Remove_Click" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Application" Style="{StaticResource Title}" Grid.ColumnSpan="3" />

                <TextBlock Text="Program" Style="{StaticResource Caption}" Grid.Row="1" />
                <TextBox x:Name="ExeBox" Grid.Row="1" Grid.Column="1" ToolTip="Path to the .exe, or drop a file onto the window" />
                <Button Content="Browse..." Click="Browse_Click" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" />

                <TextBlock Text="Arguments" Style="{StaticResource Caption}" Grid.Row="2" Margin="0,10,12,0" />
                <TextBox x:Name="ArgsBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" />

                <TextBlock Text="Work dir" Style="{StaticResource Caption}" Grid.Row="3" Margin="0,10,12,0" />
                <TextBox x:Name="WorkDirBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                         ToolTip="Optional - defaults to the program folder" />

                <CheckBox x:Name="GrantBox" IsChecked="True" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                          Content="Grant the user read + execute on the program folder" />

                <Button Content="Run as limited user" Click="Run_Click" Style="{DynamicResource AccentButtonStyle}"
                        Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="20,8" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0" Padding="4">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
        </Border>
    </Grid>
</Window>
